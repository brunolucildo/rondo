# Banco (Postgres nativo no docker compose; `bun run infra:up`).
# `rondo_app` é o usuário da API: DML nas tabelas e execute nas funções SQL.
DATABASE_URL=postgres://rondo_app:rondo@localhost:5432/rondo
# `rondo_migrator` é o dono do schema: usado somente por `bun run db:migrate` (DDL).
DATABASE_MIGRATOR_URL=postgres://rondo_migrator:rondo@localhost:5432/rondo

# Weaviate local (banco vetorial dos experts; `bun run infra:up`). So servidor, nunca com prefixo VITE_.
# O Compose sobe o Weaviate so com esta chave (sem acesso anonimo) e so em 127.0.0.1 (8080 e 50051).
# Valor de desenvolvimento local; troque antes de qualquer ambiente compartilhado.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=rondo-dev-weaviate-key
# gRPC do Weaviate (opcional; padrao: mesmo host da WEAVIATE_URL na porta 50051)
# WEAVIATE_GRPC_PORT=50051
# Chave da OpenAI para os embeddings (`text-embedding-3-small`). Opcional: sem ela, gerar embeddings
# falha com erro tipado e sem chamar a rede. So servidor, nunca com prefixo VITE_.
# OPENAI_API_KEY=

# Cliente (Vite) — apenas variáveis públicas entram no bundle
VITE_API_URL=http://localhost:3002

# API
API_PORT=3002
# Origem pública do app (React + Vite). A API só aceita CORS dessa origem.
APP_URL=http://localhost:5173
# Use true somente atrás de um proxy reverso confiável: o limite de requisições passa a usar
# o primeiro IP de X-Forwarded-For. Com false (padrão) o cabeçalho é ignorado.
TRUST_PROXY=false
# Segredo HS256 dos tokens de sessao (minimo de 32 caracteres; so servidor, nunca com prefixo VITE_).
# A API nao sobe sem ele. Gere um valor proprio, por exemplo:
#   node -p "require('node:crypto').randomBytes(48).toString('base64')"
AUTH_JWT_SECRET=troque-por-um-segredo-aleatorio

# OpenTelemetry (OTLP HTTP do collector local)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rondo-api
OTEL_EXPORTER_OTLP_TIMEOUT=3000

# Ambiente da API (opcional; padrão `dev`). Escolhe o provedor de e-mail:
#   production = Resend; test = capture (guarda em memória, só testes automatizados);
#   qualquer outro valor, inclusive ausente = Mailtrap (a mensagem fica na caixa do Mailtrap).
# Em produção, defina NODE_ENV=production: sem ele a API sobe como `dev` e usa o Mailtrap.
# NODE_ENV=dev

# E-mail transacional (só servidor; nunca com prefixo VITE_)
EMAIL_FROM="Rondo <no-reply@rondo.local>"
# Mailtrap Email Sandbox: token de API e id numérico da caixa (Settings da inbox)
MAILTRAP_API_TOKEN=coloque-o-token-de-api-do-mailtrap
MAILTRAP_INBOX_ID=coloque-o-id-da-caixa-do-mailtrap
# Resend (produção): chave de API e remetente de um domínio verificado em EMAIL_FROM
RESEND_API_KEY=coloque-a-chave-de-api-do-resend

# MCP do Grafana (opcional; `.mcp.json`): token de um service account do Grafana local
# (Administration > Users and access > Service accounts > Add token). Cada pessoa usa o seu.
# O `uvx --env-file .env` repassa TODO este arquivo ao processo do mcp-grafana; deixe aqui só
# chaves locais de desenvolvimento, nunca de produção.
GRAFANA_SERVICE_ACCOUNT_TOKEN=xxx
