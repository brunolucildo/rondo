# Banco (Postgres nativo no docker compose; `bun run infra:up`).
# `rondo_app` é o usuário da API: DML nas tabelas e execute nas funções SQL.
DATABASE_URL=postgres://rondo_app:rondo@localhost:5432/rondo
# `rondo_migrator` é o dono do schema: usado somente por `bun run db:migrate` (DDL).
DATABASE_MIGRATOR_URL=postgres://rondo_migrator:rondo@localhost:5432/rondo

# Weaviate local (banco vetorial dos experts; `bun run infra:up`). So servidor, nunca com prefixo VITE_.
# O Compose sobe o Weaviate so com esta chave (sem acesso anonimo) e so em 127.0.0.1 (8080 e 50051).
# Valor de desenvolvimento local; troque antes de qualquer ambiente compartilhado.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=rondo-dev-weaviate-key
# gRPC do Weaviate (opcional; padrao: mesmo host da WEAVIATE_URL na porta 50051)
# WEAVIATE_GRPC_PORT=50051
# Chave da OpenAI para os embeddings (`text-embedding-3-small`). Opcional: sem ela, gerar embeddings
# falha com erro tipado e sem chamar a rede. So servidor, nunca com prefixo VITE_.
# OPENAI_API_KEY=
# Conexoes de arquivos (PDF, TXT e Markdown): os limites (20 MB por arquivo, 50 conexoes por usuario,
# 2000 trechos por arquivo) sao constantes em apps/api/src/modules/connections/domain/connection-rules.ts,
# nao variaveis de ambiente. A API agora carrega o modulo do Weaviate: WEAVIATE_URL e WEAVIATE_API_KEY
# acima sao obrigatorias para subir. Sem OPENAI_API_KEY o arquivo falha com PROCESSING_UNAVAILABLE.
# Audio (MP3) e video (MP4) das conexoes sao lidos pelo Gemini (spec 0028): o arquivo e enviado a
# Files API do Google, vira texto com marcas de tempo e e apagado do Google ao fim. So servidor, nunca
# com prefixo VITE_. Sem a chave a API sobe e so o envio de MP3 e MP4 responde 503 MEDIA_UNAVAILABLE
# (o chat e os demais tipos seguem). Com NODE_ENV=test a API usa um Gemini falso (sem rede).
# GEMINI_API_KEY=
# Modelo de entendimento multimodal da familia Flash (nao o de geracao de video). O padrao e
# gemini-3.6-flash; confirme o ID vigente em ai.google.dev, pois modelos e precos mudam.
# GEMINI_UNDERSTANDING_MODEL=gemini-3.6-flash
# Limites de midia (MP3 ate 50 MB e 60 min; MP4 ate 200 MB e 20 min; 2 em processamento por usuario;
# 100 minutos por usuario em 24 h) sao constantes em connection-rules.ts, nao variaveis de ambiente.

# Cliente (Vite) — apenas variáveis públicas entram no bundle
VITE_API_URL=http://localhost:3002

# API
API_PORT=3002
# Origem pública do app (React + Vite). A API só aceita CORS dessa origem.
APP_URL=http://localhost:5173
# Use true somente atrás de um proxy reverso confiável: o limite de requisições passa a usar
# o primeiro IP de X-Forwarded-For. Com false (padrão) o cabeçalho é ignorado.
TRUST_PROXY=false
# Segredo HS256 dos tokens de sessao (minimo de 32 caracteres; so servidor, nunca com prefixo VITE_).
# A API nao sobe sem ele. Gere um valor proprio, por exemplo:
#   node -p "require('node:crypto').randomBytes(48).toString('base64')"
AUTH_JWT_SECRET=troque-por-um-segredo-aleatorio

# OpenTelemetry (OTLP HTTP do collector local)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rondo-api
OTEL_EXPORTER_OTLP_TIMEOUT=3000
# Os agentes (LangGraph) sao observados por OpenTelemetry no Grafana acima. O tracing do LangSmith
# (LANGSMITH_TRACING, LANGCHAIN_TRACING_V2) fica DESLIGADO: nao defina essas variaveis nem chaves do
# LangSmith aqui. Se estiverem no seu ambiente, a API as desliga no boot e registra
# langsmith_tracing_disabled (os runs levariam prompts e trechos de documentos a um terceiro).

# Ambiente da API (opcional; padrão `dev`). Escolhe o provedor de e-mail:
#   production = Resend; test = capture (guarda em memória, só testes automatizados);
#   qualquer outro valor, inclusive ausente = Mailtrap (a mensagem fica na caixa do Mailtrap).
# Em produção, defina NODE_ENV=production: sem ele a API sobe como `dev` e usa o Mailtrap.
# NODE_ENV=dev

# E-mail transacional (só servidor; nunca com prefixo VITE_)
EMAIL_FROM="Rondo <no-reply@rondo.local>"
# Mailtrap Email Sandbox: token de API e id numérico da caixa (Settings da inbox)
MAILTRAP_API_TOKEN=coloque-o-token-de-api-do-mailtrap
MAILTRAP_INBOX_ID=coloque-o-id-da-caixa-do-mailtrap
# Resend (produção): chave de API e remetente de um domínio verificado em EMAIL_FROM
RESEND_API_KEY=coloque-a-chave-de-api-do-resend

# Experts (chat da home): modelo de linguagem da OpenAI (so servidor; nunca com prefixo VITE_).
# Opcional no boot: sem a chave a API sobe e so o envio de mensagem responde 503 EXPERT_UNAVAILABLE.
# Com NODE_ENV=test a API usa um modelo falso (sem rede), como o e-mail `capture`.
OPENAI_API_KEY=coloque-a-chave-da-openai
OPENAI_CHAT_MODEL=gpt-4o-mini
# Recuperacao das respostas dos experts (spec 0024). Opcionais: trechos por pergunta (1 a 12, padrao 6)
# e limiar de similaridade de cosseno (0 a 1, padrao 0.30; calibrar com os embeddings reais).
# EXPERT_RETRIEVAL_MAX_CHUNKS=6
# EXPERT_RETRIEVAL_MIN_SCORE=0.30

# Conexoes de imagem (spec 0026): o modelo de visao que descreve JPG e PNG usa a mesma OPENAI_API_KEY.
# Opcional; padrao gpt-4o-mini. Sem a chave a imagem falha com PROCESSING_UNAVAILABLE; com NODE_ENV=test
# a API usa um modelo de visao falso (sem rede). Limites (10 MB, 8000 px) sao constantes em connection-rules.ts.
# OPENAI_VISION_MODEL=gpt-4o-mini

# Avatares dos experts (spec 0021): so a ferramenta manual `bun run experts:avatars` le estas variaveis
# (usa a mesma OPENAI_API_KEY). Opcionais; a API e o app nunca as leem.
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1024x1024

# MCP do Grafana (opcional; `.mcp.json`): token de um service account do Grafana local
# (Administration > Users and access > Service accounts > Add token). Cada pessoa usa o seu.
# O `uvx --env-file .env` repassa TODO este arquivo ao processo do mcp-grafana; deixe aqui só
# chaves locais de desenvolvimento, nunca de produção.
GRAFANA_SERVICE_ACCOUNT_TOKEN=xxx
